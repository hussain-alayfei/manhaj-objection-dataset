# Copy to .env for local development. Hosted values are set with `npx vercel env add` (see docs/deployment.md).

# --- Database ---------------------------------------------------------------
# Local pilot: SQLite. Supabase: use the pooler strings from Dashboard > Connect.
#   local CLI / seeding : session pooler   ...pooler.supabase.com:5432/postgres
#   Vercel (serverless) : transaction pooler ...pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///data/manhaj.db

# --- Reviewers --------------------------------------------------------------
# Create with: python scripts/create_reviewer.py <id> [--env-file .env.production.local --token-out work/token-<id>.txt]
REVIEWER_TOKEN_HASHES={}
# Accounts: anyone can sign up (name, email, password) and review. Project-wide actions
# (exports, benchmarks, phase gates, index rebuilds) need an operator token or an email listed here.
SIGNUP_ENABLED=1
ADMIN_EMAILS=
# PUBLIC_ACCESS=1 lets requests without a session browse as a read-only "visitor" (off by default).

# --- AI provider (book excerpts are sent to the provider; OpenAI calls use store=False) ---
# LLM_PROVIDER: openai | ollama | none
LLM_PROVIDER=none
OPENAI_API_KEY=
DIAGNOSIS_MODEL=
# gpt-6.1-sol supports: low | medium | high | xhigh | max
DIAGNOSIS_REASONING_EFFORT=low
DIAGNOSIS_MAX_OUTPUT_TOKENS=8000
EXTRACTOR_MODEL=
# Per-reviewer diagnoses per UTC day (0 = unlimited)
DIAGNOSE_DAILY_LIMIT=0
# Cap for all accounts together per day (protects OpenAI spend when sign-up is open); 0 = off
DIAGNOSE_GLOBAL_DAILY_LIMIT=0

# --- Semantic search ---------------------------------------------------------
# EMBEDDING_PROVIDER: openai | ollama | sentence_transformers. Leave EMBEDDING_MODEL empty for lexical-only search.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
# Must match the vector(768) column in supabase/migrations.
EMBEDDING_DIM=768
OLLAMA_URL=http://127.0.0.1:11434

# --- Original PDF storage -----------------------------------------------------
# local: data/source/<id>/original.pdf   supabase: private bucket, served via 60-second signed URLs
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=sources

# --- Hosting switches ---------------------------------------------------------
# READ_ONLY=1 on preview deployments rejects every write (history is append-only).
READ_ONLY=
# A local copy pointed at a remote (production) database is read-only unless this is 1.
ALLOW_REMOTE_WRITES=
# Extra allowed browser origins (comma-separated), e.g. a custom domain.
ALLOWED_ORIGINS=

